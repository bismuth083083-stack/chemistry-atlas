      "id": "q001",
      "type": "single-choice",
      "question": "B 的第一电离能低于 Be，最直接的电子构型原因是什么？",
      "points": 1,
      "explanation": "Be 的价电子是 2s²，B 首先移去 2p¹ 电子。能量较高的 2p 电子更易移去。",
      "difficulty": "easy",
      "tags": [
        "INORG-L08"
      ],
      "options": [
        {
          "id": "A",
          "text": "B 首先移走能量较高的 2p 电子"
        },
        {
          "id": "B",
          "text": "Be 比 B 多一个价电子层"
        },
        {
          "id": "C",
          "text": "B 的 2p 亚层已满"
        },
        {
          "id": "D",
          "text": "Be 移走的是 1s 电子"
        }
      ],
      "answer": "A"
    },
