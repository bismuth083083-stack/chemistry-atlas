{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemistry-atlas.local/schema/quiz.schema.json",
  "title": "Chemistry Atlas Quiz",
  "type": "object",
  "required": ["id", "title", "description", "subject", "chapter", "version", "totalPoints", "questions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[LTC][0-9]{2,3}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "chapter": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "totalPoints": { "type": "number", "exclusiveMinimum": 0 },
    "selection": { "$ref": "#/$defs/selection" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "role"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "role": { "type": "string" } }
      }
    },
    "scopeNote": { "type": "string" },
    "speciesCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["center", "examples", "geometry", "pointGroups"],
        "properties": {
          "center": { "type": "string" },
          "examples": { "type": "array", "items": { "type": "string" } },
          "geometry": { "type": "string" },
          "pointGroups": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "image": { "type": "string" } }
    },
    "baseQuestion": {
      "type": "object",
      "required": ["id", "type", "question", "points", "explanation", "difficulty", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{3,}$" },
        "question": { "type": "string", "minLength": 1 },
        "points": { "type": "number", "exclusiveMinimum": 0 },
        "explanation": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard", "challenging"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "knowledgePoints": { "type": "array", "items": { "type": "string" } },
        "image": {
          "type": "object",
          "required": ["src", "alt"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string" }
          }
        }
      }
    },
    "singleChoice": {
      "allOf": [{ "$ref": "#/$defs/baseQuestion" }, { "type": "object", "required": ["type", "options", "answer"], "properties": { "type": { "const": "single-choice" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } }, "answer": { "type": "string" } } }]
    },
    "multipleChoice": {
      "allOf": [{ "$ref": "#/$defs/baseQuestion" }, { "type": "object", "required": ["type", "options", "answers"], "properties": { "type": { "const": "multiple-choice" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } }, "answers": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }]
    },
    "trueFalse": {
      "allOf": [{ "$ref": "#/$defs/baseQuestion" }, { "type": "object", "required": ["type", "answer"], "properties": { "type": { "const": "true-false" }, "answer": { "type": "boolean" } } }]
    },
    "fillBlank": {
      "allOf": [{ "$ref": "#/$defs/baseQuestion" }, { "type": "object", "required": ["type", "answer"], "properties": { "type": { "const": "fill-in-the-blank" }, "answer": { "type": "string" }, "acceptableAnswers": { "type": "array", "items": { "type": "string" } }, "grading": { "$ref": "#/$defs/grading" } } }]
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "caseSensitive": { "type": "boolean", "default": false }, "collapseWhitespace": { "type": "boolean", "default": true }, "numericalTolerance": { "type": "number", "minimum": 0 } }
    },
    "question": { "oneOf": [{ "$ref": "#/$defs/singleChoice" }, { "$ref": "#/$defs/multipleChoice" }, { "$ref": "#/$defs/trueFalse" }, { "$ref": "#/$defs/fillBlank" }] },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "enum": ["fixed", "question-bank"] }, "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }, "chapter": { "type": "string" }, "difficulty": { "enum": ["easy", "medium", "hard", "challenging"] }, "tags": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
