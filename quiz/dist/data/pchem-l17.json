      "explanation": "dnⱼ=νⱼdξ；H₂的计量数为−3，因此变化为−3×0.20=−0.60 mol。",
      "difficulty": "easy",
      "tags": [
        "PCHEM-L17"
      ],
      "options": [
        {
          "id": "A",
          "text": "减少0.60 mol"
        },
        {
          "id": "B",
          "text": "减少0.20 mol"
        },
        {
          "id": "C",
          "text": "增加0.60 mol"
        },
        {
          "id": "D",
          "text": "增加0.40 mol"
        }
      ],
      "answer": "A"
    },
    {
