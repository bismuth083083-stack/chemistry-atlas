    {
      "id": "q001",
      "type": "single-choice",
      "question": "恒温下，显著正偏差并形成蒸气压极大的体系通常对应什么？",
      "points": 1,
      "explanation": "较高蒸气压使体系在较低温度达到给定外压。",
      "difficulty": "easy",
      "tags": [
        "PCHEM-L15"
      ],
      "options": [
        {
          "id": "A",
          "text": "恒压下最低沸点共沸"
        },
        {
          "id": "B",
          "text": "恒压下最高沸点共沸"
        },
        {
          "id": "C",
          "text": "所有组成均无气相"
        },
        {
          "id": "D",
          "text": "必须形成纯物质"
        }
      ],
      "answer": "A"
    },
    {
      "id": "q002",
      "type": "single-choice",
      "question": "气液共沸组成的直接判据是什么？",
