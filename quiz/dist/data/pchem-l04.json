      "tags": [
        "path function",
        "state function"
      ]
    },
    {
      "id": "q004",
      "type": "single-choice",
      "question": "采用化学热力学符号约定时，第一定律写作……",
      "options": [
        {
          "id": "A",
          "text": "ΔU=q+w"
        },
        {
          "id": "B",
          "text": "ΔU=q−w，无论 w 定义"
        },
        {
          "id": "C",
          "text": "ΔU=qw"
        },
        {
          "id": "D",
          "text": "ΔU=0 对所有过程成立"
        }
      ],
      "answer": "A",
      "points": 1,
      "explanation": "这里 w 表示环境对体系做功；因此吸热 q>0、环境对体系做功 w>0。",
      "difficulty": "easy",
      "tags": [
        "first law",
        "sign convention"
      ]
    },
    {
