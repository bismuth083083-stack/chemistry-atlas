      "id": "q001",
      "type": "single-choice",
      "question": "烃的定义是……",
      "options": [
        {
          "id": "A",
          "text": "只含碳和氢的化合物"
        },
        {
          "id": "B",
          "text": "只含氧和氢的化合物"
        },
        {
          "id": "C",
          "text": "所有含碳化合物"
        },
        {
          "id": "D",
          "text": "只含金属的化合物"
        }
      ],
      "answer": "A",
      "points": 1,
      "explanation": "烃只由碳和氢组成；含有其他元素的化合物属于取代烃或其他类别。",
      "difficulty": "easy",
